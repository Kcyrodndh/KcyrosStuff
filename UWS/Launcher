   Callback = function(Options)
      local TypeSelected = Options[1]
      
      
      if not VersionDropdown then return end

      if TypeSelected == "Main" then
         local HttpService = game:GetService("HttpService")
         local owner = "Kcyrodndh"
         local repo = "KcyrosStuff"
         local path = "UWS/Main"

         local url = string.format("https://api.github.com/repos/%s/%s/contents/%s", owner, repo, path)

         local success, response = pcall(function()
             return game:HttpGet(url)
         end)

         if not success then
             warn("Failed to fetch GitHub contents: " .. tostring(response))
             return
         end

         local data = HttpService:JSONDecode(response)

         for _, item in ipairs(data) do
             if item.type == "file" then
                 table.insert(fileNamesMain, item.name)
             end
         end
         
         Label:Set("The Main Version. More stable than Experimental, if you find any bug, try switching to Experimental.", nil, Color3.fromRGB(255, 255, 255), false) -- Title, Icon, Color, IgnoreTheme

