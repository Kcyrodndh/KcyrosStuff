print("Loading menu")

local HttpService = game:GetService("HttpService")
local owner = "Kcyrodndh"
local repo = "KcyrosStuff"
local path = "UWS/Main"

local url = string.format("https://github.com", owner, repo, path)

local success, response = pcall(function()
    return game:HttpGet(url)
end)

local fileNamesMain = {}

if success then
    local decodeSuccess, data = pcall(function()
        return HttpService:JSONDecode(response)
    end)
    
    if decodeSuccess and type(data) == "table" then
        for _, item in ipairs(data) do
            if item.type == "file" then
                table.insert(fileNamesMain, item.name)
            end
        end
    else
        warn("GitHub API rate limited or invalid response. Using default fallback option.")
        table.insert(fileNamesMain, "Latest")
    end
else
    warn("Failed to fetch GitHub contents: " .. tostring(response))
    table.insert(fileNamesMain, "Latest")
end

