local ExecuteButton = Tab:CreateButton({
   Name = "Load",
   Callback = function()
      
      local typeSelected = TypeDropdown.CurrentOption[1]
      local fileSelected = VersionDropdown.CurrentOption[1]

      
      if fileSelected == "Pick the type first!" or fileSelected == "" or not fileSelected then
         Rayfield:Notify({
            Title = "Invalid Version",
            Content = "Please pick a valid version.",
            Duration = 4,
            Image = nil
         })
         return
      end

      if typeSelected and fileSelected then
         
         local baseUrl = "https://raw.githubusercontent.com/Kcyrodndh/KcyrosStuff/main/UWS"
         local finalUrl = string.format("%s/%s/%s", baseUrl, typeSelected, fileSelected)
         
         print("Descargando y ejecutando desde: " .. finalUrl)

         
         local success, scriptContent = pcall(function()
            return game:HttpGet(finalUrl)
         end)

         if success then
            
            local runSuccess, runError = pcall(function()
               local func = loadstring(scriptContent)
               if func then
                  func()
               else
                  error("loadstring devolvió nil (revisa la sintaxis de tu script en GitHub)")
               end
            end)

            if not runSuccess then
               warn("Error al ejecutar el script de la versión: " .. tostring(runError))
            end
         else
            warn("No se pudo descargar el archivo desde GitHub: " .. tostring(scriptContent))
         end
      end
   end,
})


