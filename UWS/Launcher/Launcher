print("Loading menu")

local HttpService = game:GetService("HttpService")

local success, response = pcall(function()
    return game:HttpGet("https://githubusercontent.com")
end)

local versionsData = { Main = {"Latest"}, Experimental = {"Latest"} }

if success then
    local decodeSuccess, decoded = pcall(function()
        return HttpService:JSONDecode(response)
    end)
    if decodeSuccess and type(decoded) == "table" then
        versionsData = decoded
    else
        warn("Failed to parse versions.json, using local backup list.")
    end
else
    warn("Could not connect to GitHub to fetch the file list.")
end

local Rayfield
local rayfieldLoaded, rayfieldError = pcall(function()
    return loadstring(game:HttpGet('https://sirius.menu/rayfield'))()
end)

if rayfieldLoaded and Rayfield then
    Rayfield = rayfieldLoaded
else
    local fallbackLoaded, fallbackError = pcall(function()
        return loadstring(game:HttpGet('https://githubusercontent.com'))()
    end)
    if fallbackLoaded then
        Rayfield = fallbackLoaded
    else
        warn("Could not load Rayfield UI from any online source.")
        return
    end
end

local Window = Rayfield:CreateWindow({
   Name = "Pick your version!",
   Icon = 0,
   LoadingTitle = "Main Menu",
   LoadingSubtitle = "Choose your version.",
   ShowText = "Rayfield",
   Theme = "Amethyst",
   ToggleUIKeybind = "K",
   DisableRayfieldPrompts = true,
   DisableBuildWarnings = true,
   ConfigurationSaving = {
      Enabled = true,
      FolderName = "UWS", 
      FileName = "Menu Preferences"
   },
   Discord = {
      Enabled = false,
      Invite = "noinvitelink",
      RememberJoins = true
   },
   KeySystem = false,
   KeySettings = {
      Title = "Untitled",
      Subtitle = "Key System",
      Note = "No method of obtaining the key is provided",
      FileName = "Key",
      SaveKey = true,
      GrabKeyFromSite = false,
      Key = {"Hello"}
   }
})

local Tab = Window:CreateTab("Menu", nil)

local VersionDropdown
local Label 

local TypeDropdown = Tab:CreateDropdown({
   Name = "Pick the type of version",
   Options = {"Main", "Experimental"},
   CurrentOption = {"Main"},
   MultipleOptions = false,
   Flag = "DropdownType",
   Callback = function(Options)
      local TypeSelected = Options
      
      if not VersionDropdown or not Label then return end

      if TypeSelected == "Main" then
         Label:Set("The Main Version. More stable than Experimental, if you find any bug, try switching to Experimental.") 
         
         local listMain = versionsData.Main or {"Latest"}
         VersionDropdown:Refresh(listMain, true)
         
      elseif TypeSelected == "Experimental" then
         Label:Set("The Experimental Version. Test out new versions and features earlier, but might have bugs in it.") 
         
         local listExp = versionsData.Experimental or {"Latest"}
         VersionDropdown:Refresh(listExp, true)
      end
   end,
})

Label = Tab:CreateLabel("The Main Version. More stable than Experimental, if you find any bug, try switching to Experimental.", nil, Color3.fromRGB(255, 255, 255), false)

local initialOptions = versionsData.Main or {"Latest"}
VersionDropdown = Tab:CreateDropdown({
   Name = "Version",
   Options = initialOptions,
   CurrentOption = {"Latest"},
   MultipleOptions = false,
   Flag = "DropdownVersion",
   Callback = function(Options)
      print("Selected version file:", Options)
   end,
})

local ExecuteButton = Tab:CreateButton({
   Name = "Load",
   Callback = function()
      local typeSelected = TypeDropdown.CurrentOption
      local fileSelected = VersionDropdown.CurrentOption

      if fileSelected == "Pick the type first!" or fileSelected == "" or not fileSelected then
         Rayfield:Notify({
            Title = "Invalid Version",
            Content = "Please pick a valid version.",
            Duration = 4,
            Image = nil
         })
         return
      end

      if typeSelected and fileSelected then
         local baseUrl = "https://githubusercontent.com"
         local finalUrl = string.format("%s/%s/%s", baseUrl, typeSelected, fileSelected)
         
         print("Downloading and executing from: " .. finalUrl)

         local successLoad, scriptContent = pcall(function()
            return game:HttpGet(finalUrl)
         end)

         if successLoad then
            local runSuccess, runError = pcall(function()
               local func = loadstring(scriptContent)
               if func then
                  func()
               else
                  error("loadstring returned nil (check your GitHub script syntax)")
               end
            end)

            if not runSuccess then
               warn("Error executing version script: " .. tostring(runError))
            end
         else
            warn("Could not download file from GitHub: " .. tostring(scriptContent))
         end
      end
   end,
})

if Label and Label.Elements and Label.Elements.MainFrame then 
    Label.Elements.MainFrame.BackgroundTransparency = 1 
end

print("Loaded")
